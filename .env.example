# BenchBet – environment variables (SPEC §7.4). Local: cp .env.example .env

# HTTP port and bind address
PORT=3000
HOST=0.0.0.0

# Data (DB, vapid.json, backups/). /app/data in the container, ./data locally
DATA_DIR=./data
# DB_FILE=./data/benchbet.db

# Public URL (OG tags, default VAPID subject)
PUBLIC_URL=https://bet.logge.top

# Admins (comma-separated, matched via nameKey)
ADMIN_NAMES=Logge

# Token for import/export (at least 32 characters). Empty = admin routes disabled.
ADMIN_TOKEN=

# Web push. Empty = the server creates data/vapid.json on first start (or: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.org

# Time zone for push texts and OG tags
DISPLAY_TZ=Europe/Berlin

# Undo window after placing a guess, in seconds (0–30)
TIP_UNDO_SECONDS=5

# Allowed push services (hostname suffixes, comma-separated). Empty = FCM, Mozilla, Apple, Windows.
# PUSH_ENDPOINT_HOSTS=

# Delay and bundling of the "new bet" push, in seconds
NEW_GAME_PUSH_DELAY_SECONDS=60

# One guess per device and bet (anti-peek)
ONE_TIP_PER_DEVICE=true

# Trash retention in days
TRASH_DAYS=30

# Trusted reverse-proxy hops for X-Forwarded-For (rate limit, logs). 1 = Traefik in front.
# Number of hops, true/false, or a comma-separated IP/CIDR list.
TRUST_PROXY=1

# Header carrying the real client IP from an edge proxy, used for rate limits (bet.logge.top: cf-connecting-ip behind Cloudflare)
# CLIENT_IP_HEADER=

# pino log level
LOG_LEVEL=info

# Part of APP_VERSION (set via build arg in the Docker build)
GIT_SHA=dev
